# Discord Bot API URL for file uploads/downloads
# For local development: http://localhost:3002
# For production: https://api.lurkedaccounts.tech
VITE_FILE_SERVER_URL=https://api.lurkedaccounts.tech

# Google reCAPTCHA v3 site key for login/register protection
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key_here

# Firebase App Check site key for protecting Firebase/Auth/Firestore requests.
# You can reuse the same reCAPTCHA v3 site key if desired.
VITE_ENABLE_FIREBASE_APP_CHECK=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_v3_site_key_here
