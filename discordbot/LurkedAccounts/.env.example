# Discord Bot Configuration
# Copy this file to .env and fill in your real values. Do not commit .env to Git.

# Discord Bot Token - Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# OAuth Configuration (for RestoreCord-like verification)
# Get your client secret from: Discord Developer Portal > Your App > OAuth2
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# OAuth Redirect URI (must match what's set in Discord Developer Portal)
# For production, this should be your public API URL.
DISCORD_REDIRECT_URI=https://api.lurkedaccounts.tech/api/oauth/discord/callback
# Back-compat alias (optional)
OAUTH_REDIRECT_URI=https://api.lurkedaccounts.tech/api/oauth/discord/callback

# Web server port for OAuth callback
WEB_SERVER_PORT=3000

# API Configuration for file uploads
API_PORT=3002
API_CORS_ORIGIN=http://localhost:5173,https://lurkedaccounts.tech

# Frontend URL used for OAuth success/error redirects
FRONTEND_URL=https://lurkedaccounts.tech

# TMDb API Key (optional - for movie poster fetching in events feature)
# Get a free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
