# Discord Bot API URL for file uploads/downloads
# For local development: http://localhost:3002
# For production: public Raspberry Pi API URL
VITE_FILE_SERVER_URL=https://api.lurkedaccounts.tech

# Firebase web app configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Google reCAPTCHA v3 site key for login/register protection
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key_here
