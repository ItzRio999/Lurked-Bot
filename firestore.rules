rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/settings/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/settings/admins).data.emails;
    }

    // Admin settings - only admins can modify, all authenticated users can read
    match /settings/admins {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin logs - only admins can write, all authenticated users can read
    match /adminLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.keys().hasAll(["action", "details", "adminEmail", "timestamp"]);
      allow update, delete: if isAdmin();
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
          || request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly(["replyCount", "updatedAt"])
        );
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.authorId || isAdmin());

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || isAdmin());
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }
  }
}
