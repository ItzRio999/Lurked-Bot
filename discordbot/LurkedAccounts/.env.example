# Discord Bot Configuration
# Copy this file to .env and fill in your real values. Do not commit .env to Git.

# Discord Bot Token - Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# OAuth Configuration (for RestoreCord-like verification)
# Get your client secret from: Discord Developer Portal > Your App > OAuth2
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# OAuth Redirect URI (must match what's set in Discord Developer Portal)
# For production, this should be your public API URL.
DISCORD_REDIRECT_URI=https://api.lurkedaccounts.tech/api/oauth/discord/callback
# Back-compat alias (optional)
OAUTH_REDIRECT_URI=https://api.lurkedaccounts.tech/api/oauth/discord/callback

# Web server port for OAuth callback
WEB_SERVER_PORT=3000

# API Configuration for file uploads
API_PORT=3002
API_CORS_ORIGIN=http://localhost:5173,https://lurkedaccounts.netlify.app

# Frontend URL used for OAuth success/error redirects
FRONTEND_URL=https://lurkedaccounts.netlify.app

# Optional server ad URL overrides. If these change, restart the bot and the
# tracked /server-ad embed will refresh on startup.
SERVER_AD_WEBSITE_URL=https://lurkedaccounts.tech/#home
SERVER_AD_DISCORD_INVITE=https://discord.gg/UekZuzk5gW
SERVER_AD_LURKEDTV_URL=https://lurkedtv.vercel.app/#

# Google reCAPTCHA v3
# Create keys at: https://www.google.com/recaptcha/admin/create
RECAPTCHA_V3_SECRET_KEY=your_recaptcha_v3_secret_key_here
# Optional: default is 0.5
RECAPTCHA_V3_MIN_SCORE=0.5
# Optional hardening: comma-separated hostnames returned by Google
RECAPTCHA_ALLOWED_HOSTNAMES=lurkedaccounts.netlify.app,localhost

# Optional vouch proof attachment limits
VOUCH_MAX_IMAGE_BYTES=5242880
VOUCH_MAX_VIDEO_BYTES=10485760

# TMDb API Key (optional - for movie poster fetching in events feature)
# Get a free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
